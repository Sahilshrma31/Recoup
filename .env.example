# Copy to .env and fill in. Every value below is optional: with none of them set
# the agent runs fully offline against the mock gateway and the deterministic
# rules engine, which is enough to run the demo end to end.

# --- AI reasoning layer (optional) ---
# Without a key the agent falls back to the deterministic diagnosis engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_ENABLED=true
AI_EFFORT=low

# --- Razorpay (optional; test-mode keys are enough) ---
# RAZORPAY_LIVE=true additionally switches execution from the mock gateway to
# real payment-link creation and real status polling.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE=false

# --- Storage ---
# SQLite by default; point at PostgreSQL and nothing else changes.
DATABASE_URL=sqlite:///./data/recovery.db

# --- Recovery policy (deterministic guardrails) ---
AUTO_ACTION_LIMIT_PAISE=1000000     # above Rs 10,000 -> merchant approval
MAX_AUTO_RETRIES=2
MAX_OUTREACH_ATTEMPTS=2
RECOVERY_WINDOW_DAYS=14
MIN_RECOVERY_PROBABILITY=0.20
