# Copy to .env and fill in. Every value below is optional: with none of them set
# the agent runs fully offline against the mock gateway and the deterministic
# rules engine, which is enough to run the demo end to end.

# --- AI reasoning layer (optional) ---
# Without a key the agent falls back to the deterministic diagnosis engine.
# Two providers are supported; the agent behaves identically either way -- the
# model proposes, the policy engine disposes, and any failure degrades to rules.
LLM_PROVIDER=nvidia          # nvidia | anthropic
AI_ENABLED=true
AI_EFFORT=low                # anthropic only

# NVIDIA NIM (OpenAI-compatible API).
# nemotron-3-super-120b-a12b was chosen by measurement, not reputation: of the
# 81 models the catalogue exposes, it is the fastest that both holds our JSON
# schema and gets the ambiguous `do_not_honour` case right.
# See README -> "Choosing the NVIDIA model".
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Razorpay (optional; test-mode keys are enough) ---
# RAZORPAY_LIVE=true additionally switches execution from the mock gateway to
# real payment-link creation and real status polling.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVE=false

# --- Storage ---
# SQLite by default; point at PostgreSQL and nothing else changes.
DATABASE_URL=sqlite:///./data/recovery.db

# --- Recovery policy (deterministic guardrails) ---
AUTO_ACTION_LIMIT_PAISE=1000000     # above Rs 10,000 -> merchant approval
MAX_AUTO_RETRIES=2
MAX_OUTREACH_ATTEMPTS=2
RECOVERY_WINDOW_DAYS=14
MIN_RECOVERY_PROBABILITY=0.20
